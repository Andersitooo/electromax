# ElectroMax / anderspace.online
# Copia este archivo como .env en el VPS y cambia los valores.
# No subas .env a repositorios públicos.

APP_ENV=production
APP_URL=https://anderspace.online
APP_DEBUG=0
APP_TIMEZONE=America/Guayaquil

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=electromax
DB_USER=electromax_user
DB_PASSWORD=CAMBIA_ESTA_CLAVE_POSTGRES

# SMTP para facturas, notas de crédito y correos del sistema.
# Para Gmail usa contraseña de aplicación, no la contraseña normal de la cuenta.
EMX_SMTP_HOST=smtp.gmail.com
EMX_SMTP_PORT=587
EMX_SMTP_SECURE=tls
EMX_SMTP_USER=tu_correo@gmail.com
EMX_SMTP_PASS=PEGA_AQUI_TU_APP_PASSWORD
EMX_SMTP_FROM_EMAIL=tu_correo@gmail.com
EMX_SMTP_FROM_NAME=ElectroMax Facturación
EMX_SMTP_BCC_EMPRESA=

# 0 = enviar al correo real del cliente.
# 1 = redirigir todo a EMX_MAIL_CORREO_PRUEBA.
EMX_MAIL_MODO_PRUEBA=0
EMX_MAIL_CORREO_PRUEBA=tu_correo@gmail.com

# Google login
# Si no lo usarás, deja el Client ID actual o vacío en app/Config/google.php.
EMX_GOOGLE_CLIENT_ID=
