# ElectroMax public/.htaccess
Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<FilesMatch "^(\.env|\.env\..*|composer\.(json|lock)|.*\.sql|.*\.log|.*\.ini|.*\.sh|README.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On

# Si el archivo o carpeta existe dentro de public, se sirve directamente.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rutas limpias o no existentes pasan al router.
RewriteRule ^ router.php [QSA,L]
</IfModule>
